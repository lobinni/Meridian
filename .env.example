# ---------------------------------------------------------------------------
# Meridian Tribunal — environment configuration
# Copy this file to `.env.local` (local dev) or set these in your host's
# environment panel (Vercel / Docker / CI).
#
# These are PLAIN server-resolved variables — intentionally NOT prefixed with
# any public framework prefix. They are read on the server and injected into
# the app shell at render time, so nothing here is ever inlined into the
# browser bundle. DO NOT prefix them.
#
# Every value below also has a matching fallback constant in
# `src/lib/config.ts`, so all of them are optional.
# ---------------------------------------------------------------------------

# Deployed contract address. Preconfigured to the live Studionet deployment;
# replace after your own redeploy. Leave EMPTY only to intentionally disable
# on-chain actions (the interface then shows a "contract not configured"
# notice — the dApp never substitutes simulated data).
CONTRACT_ADDRESS=0xc3f49B0AbD1957dcc8f05742cBB29751cEcACf97

# GenLayer RPC endpoint (Studio API gateway).
GENLAYER_RPC_URL=https://studio.genlayer.com/api

# Expected wallet chain id (decimal). 61999 = GenLayer studionet (0xf22f).
GENLAYER_CHAIN_ID=61999

# Human-readable network label used across the UI.
GENLAYER_CHAIN_NAME=Studionet

# Native token ticker.
NATIVE_SYMBOL=GEN

# Block explorer base URL (no trailing slash).
EXPLORER_URL=https://explorer-studio.genlayer.com
